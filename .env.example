# 只列變數名稱，不放任何值。實際值請在 Vercel 的 Settings > Environment Variables 設定。
# 說明文件：docs/vue-workspace/go-live/vercel-env.md

# Supabase（Production 與 Preview 必須分開設，不要勾 All Environments）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPECTED_SUPABASE_PROJECT_REF=

# 新版工作台閘門
WORKSPACE_ENABLED=
WORKSPACE_ALLOWED_REFS=
WORKSPACE_AUDIENCE=
WORKSPACE_USE_EXISTING_SESSION=
WORKSPACE_ORIGIN=
WORKSPACE_PUBLIC_REDIRECT_ENABLED=
WORKSPACE_SCAN_REDIRECT=

# 網站網址
NEXT_PUBLIC_SITE_URL=

# 語音 AI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SML_VOICE_DRAFT_MODEL=

# 門市地圖
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# 只給 Preview（測試）用的模擬開關，Production 一定不能存在：
# WORKSPACE_DEV_ENABLED
# WORKSPACE_CALENDAR_MOCK
# WORKSPACE_AUTH_MAIL_MOCK
# WORKSPACE_OPENAI_MOCK

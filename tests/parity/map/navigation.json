{
  "page": "navigation",
  "legacyRoute": "(全站 Navbar：components/Navbar.tsx)",
  "workItem": "T02",
  "entries": [
    {
      "id": "nav-visibility",
      "mechanism": "navigation",
      "description": "以角色登入實際開啟舊站，從舊 Navbar DOM（桌機展開所有下拉子選單）擷取選單連結 href 與文字，對照新版殼層實際渲染的『全站功能選單』（以 session navigation 反查 href）。角色矩陣的 role 類帳號走 DOM；module 類帳號沒有 DOM 證據，退回規則表求值（報告的 legacy.endpoint 會標明）。parity 報告以 DOM 為準。",
      "legacy": {
        "source": "components/Navbar.tsx 渲染後的 DOM（備援：hooks/useNavbarPermissions.ts 規則表）",
        "api": {
          "path": "/api/permissions/user",
          "pick": "permissions"
        }
      },
      "native": {
        "source": "/workspace/index.html 全站功能選單 DOM；href 由 /api/workspace/session navigation 反查",
        "api": {
          "path": "/api/workspace/session",
          "pick": "navigation"
        }
      },
      "compareKey": "href",
      "normalize": {},
      "notes": "舊版事實來源：/api/permissions/user（有效權限）、/api/user/profile（profiles.role）、/api/general-affairs/access（服務中心入口）；角色碼取自 tests/fixtures/role-matrix.json 的 roleCode + systemRoles（舊版 Navbar 在瀏覽器端查 user_roles，無對應 REST）。"
    },
    {
      "id": "nav-rules-vs-dom",
      "mechanism": "navigation",
      "description": "單元層快速檢查用的規則表求值，與舊 Navbar 實際渲染的 DOM 逐項比對。兩者不一致（rule-only / dom-only）代表規則表漂移或擷取有誤，報告必須標出。",
      "legacy": {
        "source": "navRules / navFlags 規則表求值"
      },
      "native": {
        "source": "舊 Navbar DOM（桌機）"
      },
      "compareKey": "href",
      "normalize": {}
    },
    {
      "id": "nav-legacy-mobile-vs-desktop",
      "mechanism": "navigation",
      "description": "舊 Navbar 桌機（展開所有下拉）與手機（展開漢堡選單）看到的入口必須一致。",
      "legacy": {
        "source": "舊 Navbar DOM（桌機 1440）"
      },
      "native": {
        "source": "舊 Navbar DOM（手機 390，漢堡選單展開）"
      },
      "compareKey": "href",
      "normalize": {}
    },
    {
      "id": "nav-native-dom-vs-session",
      "mechanism": "navigation",
      "description": "新版殼層實際渲染的選單，與 /api/workspace/session 的 navigation 必須一致（畫面沒有漏項或多項）。",
      "legacy": {
        "source": "/api/workspace/session navigation"
      },
      "native": {
        "source": "/workspace/index.html 全站功能選單 DOM"
      },
      "compareKey": "href",
      "normalize": {}
    },
    {
      "id": "effective-permissions",
      "mechanism": "api-read",
      "description": "舊 /api/permissions/user 與新 /api/workspace/session 的有效權限碼集合必須一致（導覽可見性比對的前提）。",
      "legacy": {
        "api": {
          "path": "/api/permissions/user",
          "pick": "permissions"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/session",
          "pick": "permissions"
        }
      },
      "normalize": {}
    }
  ],

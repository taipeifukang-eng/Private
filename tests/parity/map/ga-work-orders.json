    { "id": "wo-force-close-write-readback", "mechanism": "write-readback", "description": "強制結案後回讀工單、需求單與進度紀錄：舊版 POST /api/maintenance-updates（action=FORCE_CLOSE）與新版 POST /work-orders/:id/force-close。", "legacy": { "api": { "path": "/api/maintenance-updates", "method": "POST" } }, "native": { "api": { "path": "/api/workspace/general-affairs/work-orders/:id/force-close", "method": "POST" } } },

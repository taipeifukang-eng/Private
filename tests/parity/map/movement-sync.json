{
  "page": "movement-sync",
  "legacyRoute": "/api/employee-movements/batch",
  "workItem": "W06",
  "entries": [
    {
      "id": "promo-unlocked",
      "mechanism": "write-readback",
      "description": "升職（草稿月份）：同一組員工與月份名冊，舊版 /api/employee-movements/batch 與新版 movement-submit 寫入後，回讀異動歷史與每月人員狀態。主檔職位：舊版 DEV 沒有同步（B.3）；新版同步為最新有效升職。月結頁新增近期因異動自動調整紀錄（A.3）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/batch",
          "method": "POST"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/movement-submit",
          "method": "POST"
        }
      }
    },
    {
      "id": "promo-locked",
      "mechanism": "write-readback",
      "description": "升職（已送審月份）：舊版直接改寫已送審月份；新版不動，記入需重新確認清單（A.2）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/batch",
          "method": "POST"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/movement-submit",
          "method": "POST"
        }
      }
    },
    {
      "id": "leave-resign-after-init",
      "mechanism": "write-readback",
      "description": "初始化後才登錄留停、離職：舊版只改員工主檔，名冊不會跟著變；新版回寫生效月與之後已初始化的月份（A.1、A.4）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/batch",
          "method": "POST"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/movement-submit",
          "method": "POST"
        }
      }
    },
    {
      "id": "same-day-multi-level",
      "mechanism": "write-readback",
      "description": "同日登記新人二階與專員：舊版以最後登記者為準；新版取相對最高的職等（B.2）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/batch",
          "method": "POST"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/movement-submit",
          "method": "POST"
        }
      }
    },
    {
      "id": "acting-manager",
      "mechanism": "write-readback",
      "description": "代理店長：舊版與新版都只在生效月起標註記、不改正式職位（對等，無差異）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/batch",
          "method": "POST"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/movement-submit",
          "method": "POST"
        }
      }
    },
    {
      "id": "edit-promotion",
      "mechanism": "write-readback",
      "description": "修改升職異動（草稿月份）：舊版 PATCH /api/employee-movements/[id] 與新版同一路徑改升職職位後，回讀異動歷史與每月人員狀態職位；主檔職位新版同步（B.3）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/[id]",
          "method": "PATCH"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/employee-movements/[id]",
          "method": "PATCH"
        }
      }
    },
    {
      "id": "edit-name",
      "mechanism": "write-readback",
      "description": "修改姓名：舊版連已送審月份的姓名一併改寫；新版已送審月份不動（A.2），草稿月份、員工主檔與異動歷史一致。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/[id]",
          "method": "PATCH"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/employee-movements/[id]",
          "method": "PATCH"
        }
      }
    },
    {
      "id": "delete-latest",
      "mechanism": "write-readback",
      "description": "刪除員工最新一筆異動：舊版只刪歷史與重算升職時間軸，主檔不恢復；新版恢復員工主檔職位並重算名冊（C.1）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/[id]",
          "method": "DELETE"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/employee-movements/[id]",
          "method": "DELETE"
        }
      }
    },
    {
      "id": "delete-non-latest",
      "mechanism": "write-readback",
      "description": "刪除非最新一筆：舊版任一筆都可刪；新版只能刪最新一筆，其餘回 409 提示先刪較新的（C.1）。",
      "legacy": {
        "api": {
          "path": "/api/employee-movements/[id]",
          "method": "DELETE"
        }
      },
      "native": {
        "api": {
          "path": "/api/workspace/employee-movements/[id]",
          "method": "DELETE"
        }
      }
    }
  ]
}
